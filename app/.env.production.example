APP_NAME=Mangie
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=Australia/Melbourne
APP_URL=https://mangie.vaell.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=shared-mysql
DB_PORT=3306
DB_DATABASE=mangie
DB_USERNAME=mangie
DB_PASSWORD=CHANGE_ME
DB_WAIT_MAX_ATTEMPTS=60

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=mangie.vaell.dev
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=mangie_cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@vaell.dev
MAIL_FROM_NAME=Mangie

REVERB_APP_ID=mangie-production
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_ALLOWED_ORIGINS=mangie.vaell.dev
REVERB_HOST=mangie.vaell.dev
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME=Mangie
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TRUSTED_PROXIES=*
PRODUCT_BACKLOG_BOARD_ID=1

MANGIE_HTTP_PORT=8081
MANGIE_REVERB_PORT=8082
MANGIE_IMAGE_TAG=latest
